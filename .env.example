# Kalshi API Configuration
# Get your API credentials from https://kalshi.com/
# Instructions: Go to Account Settings > API Keys to generate your credentials

KALSHI_API_KEY_ID="your-api-key-id-here"
KALSHI_PRIVATE_KEY_PATH=/path/to/your/private-key.txt

# Environment Selection (uncomment one)

# DEMO (for testing with fake money)
#KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2

# PRODUCTION (for real trading)
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
