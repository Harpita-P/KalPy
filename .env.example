# Kalshi API setup
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Live 99c scanner settings
SCAN_INTERVAL_SECONDS=5
TARGET_PRICE_CENTS=99
ALERT_PRICE_CENTS=98
ENTRY_PRICE_CENTS=99
EXIT_TRIGGER_CENTS=40
MAX_ORDER_DOLLARS=5
POSITION_SIZE_PCT=0.40
SPORTS_FILTERS=baseball
BASEBALL_GAME_SERIES_TICKER=KXMLBGAME
CSV_FILE=kalshi_99_alerts.csv
POSITIONS_CSV_FILE=kalshi_positions.csv
DRY_RUN=true

# Optional API tuning
MARKET_LIMIT=200
MAX_MARKET_PAGES=5
REQUEST_TIMEOUT_SECONDS=20
ORDERBOOK_SLEEP_SECONDS=0.15
